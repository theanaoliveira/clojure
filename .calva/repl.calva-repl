(deftest nao-sei-o-nome-ainda-test
  (testing "Dado um valor abaixo de 100 reais, então a taxa de entrega deve ser de 15 reais"
    (is (= 15 (taxa-de-entrega 95))))
  (testing "Dado um valor maior que 100 reais e menor que 200, então a taxa de entrega deve ser de 5 reais"
    (is (= 5 (taxa-de-entrega 101)))
    (is (= 5 (taxa-de-entrega 150)))
    (is (= 5 (taxa-de-entrega 199))))
  (testing "Dado um valor maior que 200 reais, não deve cobrar taxa de entrega"
    (is (= 0 (taxa-de-entrega 101)))
    (is (= 0 (taxa-de-entrega 150)))))

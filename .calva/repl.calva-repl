(defn imposto-retido
  "Calcula o imposto do salario com base no valor"
  [salario]
  (let [isento                 0
        imposto-primeira-faixa 0.1
        imposto-segunda-faixa  0.2]
    (if (<= salario 1000)
      (* salario isento)
      (if (< salario 2000)
        (* salario imposto-primeira-faixa)
        (* salario imposto-segunda-faixa)))))
